{
  "name": "@ucp-js/sdk",
  "version": "0.0.0-draft",
  "description": "UCP SDK for JavaScript",
  "license": "Apache-2.0",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./openapi.json": "./dist/openapi.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && npm run build:cjs && npm run build:esm && npm run build:types && cp src/openapi.json dist/openapi.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && echo '{\"type\": \"module\"}' > dist/esm/package.json",
    "build:types": "tsc -p tsconfig.types.json",
    "build:noEmit": "tsc --noEmit",
    "generate": "./generate_models.sh",
    "prepare": "npm run build",
    "pretest": "tsc -p tests/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Universal-Commerce-Protocol/js-sdk"
  }
}
